  "$id": "urn:cds:schema:common:entity-reference",
  "version": "0.2.0",
  "title": "CDS Entity Reference",
  "type": "object",
  "properties": {
    "document_type": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 3
