{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cds:schema:reference:facet-definition",
  "version": "0.2.0",
  "title": "CDS Facet Definition",
  "allOf": [
    {
      "$ref": "urn:cds:schema:common:envelope"
    },
    {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "facet_definition"
        },
        "facet_id": {
          "type": "string",
          "minLength": 3
        },
        "label": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:cds:schema:common:localised-text"
          },
          "$comment": "Single localised-text model corpus-wide (CDS1100-15)."
        },
        "source_attribute_id": {
          "type": "string",
          "minLength": 1
        },
        "selection_mode": {
          "type": "string",
          "enum": [
            "single",
            "multi_or",
            "multi_and",
            "range"
          ]
        },
        "sort_mode": {
          "type": "string",
          "enum": [
            "configured",
            "alphabetical",
            "count",
            "numeric"
          ]
        },
        "value_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "facet_id",
        "label",
        "source_attribute_id",
        "selection_mode",
        "sort_mode",
        "value_ids"
      ]
    }
  ],
  "unevaluatedProperties": false
}
