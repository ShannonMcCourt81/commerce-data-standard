{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cds:schema:reference:dictionary-value",
  "version": "0.2.0",
  "title": "CDS Dictionary Value",
  "allOf": [
    {
      "$ref": "urn:cds:schema:common:envelope"
    },
    {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "dictionary_value"
        },
        "dictionary_value_id": {
          "type": "string",
          "minLength": 3
        },
        "dictionary_id": {
          "type": "string",
          "minLength": 3
        },
        "canonical_code": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "canonical_label": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:cds:schema:common:localised-text"
          },
          "$comment": "Single localised-text model corpus-wide (CDS1100-15)."
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "facet_memberships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "facet_id": {
                "type": "string"
              },
              "value_id": {
                "type": "string"
              },
              "primary": {
                "type": "boolean"
              }
            },
            "required": [
              "facet_id",
              "value_id",
              "primary"
            ],
            "additionalProperties": false
          }
        },
        "channel_representations": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "parent_value_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "dictionary_value_id",
        "dictionary_id",
        "canonical_code",
        "canonical_label",
        "aliases",
        "facet_memberships",
        "channel_representations"
      ]
    }
  ],
  "unevaluatedProperties": false
}
