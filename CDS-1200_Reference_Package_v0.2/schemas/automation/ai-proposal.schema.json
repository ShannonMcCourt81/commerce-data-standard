{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cds:schema:automation:ai-proposal",
  "version": "0.2.0",
  "title": "CDS AI Proposal",
  "allOf": [
    {
      "$ref": "urn:cds:schema:common:envelope"
    },
    {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "ai_proposal"
        },
        "proposal_id": {
          "type": "string",
          "minLength": 3
        },
        "target_document_id": {
          "type": "string",
          "minLength": 3
        },
        "target_field": {
          "type": "string",
          "minLength": 1
        },
        "proposed_value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "source_type": {
                "type": "string"
              },
              "source_reference": {
                "type": "string"
              },
              "excerpt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "source_type",
              "source_reference",
              "excerpt"
            ],
            "additionalProperties": false
          }
        },
        "model_id": {
          "type": "string"
        },
        "workflow_version": {
          "type": "string"
        },
        "review_state": {
          "type": "string",
          "enum": [
            "proposed",
            "review_required",
            "accepted",
            "rejected",
            "superseded",
            "expired"
          ],
          "$comment": "Shared review-state enum, identical to CDS-700 §6 R015. Replaces v0.1 proposal_status."
        },
        "task_type": {
          "type": "string",
          "enum": [
            "extraction",
            "mapping",
            "classification",
            "writing",
            "translation",
            "analysis"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "Human or policy that authorised acceptance; null while unreviewed (CDS-700 §6, R054)."
        },
        "accepted_revision": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "$comment": "Revision of the target document into which the accepted value landed; null until accepted."
        },
        "validation_results": {
          "type": "array",
          "items": {
            "$ref": "urn:cds:schema:assurance:validation-output"
          }
        }
      },
      "required": [
        "proposal_id",
        "target_document_id",
        "target_field",
        "proposed_value",
        "confidence",
        "evidence",
        "model_id",
        "workflow_version",
        "review_state",
        "task_type",
        "validation_results"
      ]
    }
  ],
  "unevaluatedProperties": false
}
