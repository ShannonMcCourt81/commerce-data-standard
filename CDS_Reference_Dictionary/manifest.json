{
  "package": "CDS Reference Dictionary",
  "version": "0.7.2",
  "status": "informative-starter-data",
  "locale": "en-GB",
  "supersedes": [
    "CDS Reference Dictionary 0.4.0",
    "CDS-1500_Starter_Reference_Dictionaries_v0.2 (0.2.0)",
    "CDS_Dictionary_Expansion_Packs_v0.1 (0.1.0)"
  ],
  "chapters": {
    "1": {
      "title": "Colours",
      "description": "Shades and the broad families they file under. A shade belongs to one or two families (first listed = primary).",
      "dictionaries": [
        "colour_facets",
        "colour_reference_values"
      ]
    },
    "2": {
      "title": "Materials",
      "description": "What things are made of - fibres and substances (cotton, wool, oak, ceramic). How a textile is constructed lives in Chapter 3.",
      "dictionaries": [
        "apparel_materials",
        "homewares_materials",
        "material_facets"
      ]
    },
    "3": {
      "title": "Fabrics & Construction",
      "description": "How a textile is made - weaves, knits and constructions (denim, jersey, tulle). Fibres such as cotton and wool live in Chapter 2, Materials: a cotton jersey tee is Material: Cotton + Fabric: Jersey.",
      "dictionaries": [
        "fabric_types"
      ]
    },
    "4": {
      "title": "Care",
      "description": "Descriptive care values (deliberately not the trademarked care-symbol set).",
      "dictionaries": [
        "care_instructions"
      ]
    },
    "5": {
      "title": "Sizing",
      "description": "Sizing systems, not sizes - a size value only means something with its system declared (AU 12, US bra, EU kids height).",
      "dictionaries": [
        "size_systems"
      ]
    },
    "6": {
      "title": "Apparel Attributes",
      "description": "Fit, style, occasion, pattern, neckline, sleeve and length vocabularies. The style vocabulary is shared across fashion and interiors.",
      "dictionaries": [
        "fits",
        "styles",
        "occasions",
        "patterns",
        "necklines",
        "sleeve_types",
        "garment_lengths",
        "swim_styles"
      ]
    },
    "7": {
      "title": "Homewares Attributes",
      "description": "Rooms, surface finishes and shapes.",
      "dictionaries": [
        "rooms",
        "finishes",
        "shapes"
      ]
    },
    "8": {
      "title": "Footwear",
      "description": "Styles, heel heights, closures, toe shapes and width fittings. Upper materials reuse Chapter 2.",
      "dictionaries": [
        "footwear_styles",
        "footwear_heel_heights",
        "footwear_closures",
        "footwear_toe_shapes",
        "footwear_width_fittings"
      ]
    },
    "9": {
      "title": "Jewellery & Accessories",
      "description": "Metals, stones, closures and piece styles.",
      "dictionaries": [
        "jewellery_metals",
        "jewellery_stones",
        "jewellery_closures",
        "jewellery_styles"
      ]
    },
    "10": {
      "title": "Beauty & Personal Care",
      "description": "Skin and hair states, scent families, formulations and finishes. Benefit claims (anti-ageing, hypoallergenic) are excluded by design - they need evidence, not filters.",
      "dictionaries": [
        "beauty_skin_types",
        "beauty_hair_types",
        "beauty_scent_families",
        "beauty_formulations",
        "beauty_makeup_finishes"
      ]
    },
    "11": {
      "title": "Electronics & Appliances",
      "description": "Brown and white goods: connections, screen technologies, power, mounting and energy-label schemes. Compliance marks and vendor ecosystems excluded.",
      "dictionaries": [
        "connectivity",
        "screen_technologies",
        "power_sources",
        "installation_types",
        "energy_rating_systems"
      ]
    },
    "12": {
      "title": "Sports & Outdoor",
      "description": "The shop-by-sport facet, plus surf wetsuit attributes (style, thickness, zip entry, seam construction). Performance claims, skill levels and vendor fin systems excluded.",
      "dictionaries": [
        "sport_activities",
        "wetsuit_styles",
        "wetsuit_thicknesses",
        "wetsuit_zips",
        "wetsuit_seams"
      ]
    },
    "13": {
      "title": "Toys & Games",
      "description": "Play types and retail age bands. The packaging safety mark (3+) is a compliance label, not filter vocabulary.",
      "dictionaries": [
        "play_types",
        "toy_age_ranges"
      ]
    },
    "14": {
      "title": "Pet Supplies",
      "description": "Pet types, species-neutral life stages (puppy/kitten are display mappings) and animal sizes. Breed lists and health claims excluded.",
      "dictionaries": [
        "pet_types",
        "pet_life_stages",
        "pet_sizes"
      ]
    },
    "15": {
      "title": "Furniture",
      "description": "Assembly forms. Furniture styles live in the Chapter 6 style vocabulary; upholstery reuses Fabrics and Materials.",
      "dictionaries": [
        "assembly_types"
      ]
    },
    "16": {
      "title": "Garden & Outdoor",
      "description": "Sun exposure - a grower-declared growing condition. Plant taxonomies and watering claims deliberately excluded.",
      "dictionaries": [
        "sun_exposure"
      ]
    }
  },
  "note": "Canonical meanings are never silently redefined; changes go through deprecation with replacement mappings. Folder is unversioned by design; this manifest is the version authority.",
